# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
# Leave unset locally to use SQLite (instance/site.db). On Render, use your Postgres URL.
# DATABASE_URL=postgresql://user:pass@host:5432/pyvejournal

# Password-reset emails (optional). For Gmail, use an app password.
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-app-password

# Set to 0 to hide the "Try the demo" button.
# DEMO_ENABLED=1
